PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loomlead_crm
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/loomlead_crm

# JWT Security Secret
JWT_SECRET=loomlead_super_secret_jwt_key_2026_xyz!@#
JWT_EXPIRES_IN=7d

# Google Places / Maps API Key (Used by Axios service)
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here

# AI Model API Key (Gemini / OpenAI / Custom LLM API endpoint)
AI_API_KEY=your_ai_api_key_here
AI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Super Admin Credential Defaults
SUPERADMIN_EMAIL=admin@loomlead.com
SUPERADMIN_PASSWORD=password123

# WhatsApp & Outreach / DND Configuration
DEFAULT_COUNTRY_CODE=IN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_token_here
DEFAULT_SENDER_EMAIL=outreach@loomlead.com
SEQUENCE_WORKER_INTERVAL=* * * * *

# Lead Scoring & Queue Engine Configuration
SCORING_QUEUE_CONCURRENCY=5
DEFAULT_LEAD_SCORE_BASE=50

# Public REST API & Rate Limiting
PUBLIC_API_RATE_LIMIT=120
PUBLIC_API_BASE_URL=https://api.yogkart.com/loomlead/api/v1/public

# Outgoing Webhooks & Retry Configuration
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_INTERVAL_SECONDS=30

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:4200
