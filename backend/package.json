{
  "name": "loomlead-crm-backend",
  "version": "1.0.0",
  "description": "LoomLead Multi-Tenant SaaS CRM Backend with Axios, PostgreSQL, Google Maps Lead Scraper, and AI Copilot",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/config/initDb.js",
    "db:migrate": "node src/migrations/runMigrations.js",
    "merge-duplicates": "node scripts/mergeDuplicates.js",
    "merge-duplicates:execute": "node scripts/mergeDuplicates.js --execute"
  },
  "keywords": [
    "crm",
    "saas",
    "multi-tenant",
    "nodejs",
    "axios",
    "postgresql",
    "google-maps",
    "ai-agent"
  ],
  "author": "LoomLead CRM Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
